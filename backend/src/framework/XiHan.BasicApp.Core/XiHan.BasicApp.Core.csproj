<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\..\props\netcore.props" />
    <Import Project="..\..\..\props\common.props" />
    <Import Project="..\..\..\props\version.props" />
    <Import Project="..\..\..\props\nuget.props" />
    <Import Project="..\..\..\props\framework.props" />

    <PropertyGroup>
        <Title>XiHan.BasicApp.Core</Title>
        <AssemblyName>XiHan.BasicApp.Core</AssemblyName>
        <PackageId>XiHan.BasicApp.Core</PackageId>
        <Description>曦寒基础应用核心库</Description>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <!--
        曦寒框架引用：下面两组二选一，由 props\framework.props 的 UseXiHanFrameworkSource 决定
        （框架源码与本仓库并列检出时自动走源码，否则走 NuGet 包）。两组须保持同一份清单。
        全仓库的框架引用只集中在本工程与 XiHan.BasicApp.Web.Core，其余工程一律经这两者传递。
    -->
    <!-- 承接的授权检查上下文与声明扩展用到 HttpContext / ClaimsPrincipal -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- 承接 4.x Templating / Bot / ObjectStorage / Timing 的第三方依赖 -->
    <ItemGroup>
        <PackageReference Include="Scriban" Version="7.5.1" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
        <PackageReference Include="TimeZoneConverter" Version="8.0.0" />
        <PackageReference Include="MailKit" Version="4.18.1" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageReference Include="AlibabaCloud.SDK.Dysmsapi20170525" Version="4.4.0" />
        <PackageReference Include="TencentCloudSDK.Sms" Version="3.0.1499" />
        <PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
        <PackageReference Include="Aliyun.OSS.SDK.NetCore" Version="2.14.1" />
        <PackageReference Include="Minio" Version="7.0.0" />
        <PackageReference Include="Tencent.QCloud.Cos.Sdk" Version="5.4.51" />
    </ItemGroup>

    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' != 'true' ">
        <PackageReference Include="XiHan.Framework.Primitives" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Kernel" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Domain" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Persistence.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Persistence.SqlSugar" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Caching.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.MultiTenancy.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Security.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Messaging.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Localization.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.ObjectStorage.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Scheduling.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Configuration.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Auditing.Abstractions" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Observability.OpenTelemetry" Version="$(XiHanFrameworkVersion)" />
        <!-- 过渡：4.x 的工具库（反射、硬件信息、加密、随机码、表达式），不依赖 4.x 基础设施；5.0 不再包装，后续按需搬进应用 -->
        <PackageReference Include="XiHan.Framework.Utils" Version="$(XiHanLegacyUtilsVersion)" />
    </ItemGroup>

    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' == 'true' ">
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Primitives\XiHan.Framework.Primitives.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Kernel\XiHan.Framework.Kernel.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Domain\XiHan.Framework.Domain.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Persistence.Abstractions\XiHan.Framework.Persistence.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Persistence.SqlSugar\XiHan.Framework.Persistence.SqlSugar.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Caching.Abstractions\XiHan.Framework.Caching.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.MultiTenancy.Abstractions\XiHan.Framework.MultiTenancy.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Security.Abstractions\XiHan.Framework.Security.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Messaging.Abstractions\XiHan.Framework.Messaging.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Localization.Abstractions\XiHan.Framework.Localization.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.ObjectStorage.Abstractions\XiHan.Framework.ObjectStorage.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Scheduling.Abstractions\XiHan.Framework.Scheduling.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Configuration.Abstractions\XiHan.Framework.Configuration.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Auditing.Abstractions\XiHan.Framework.Auditing.Abstractions.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Observability.OpenTelemetry\XiHan.Framework.Observability.OpenTelemetry.csproj" />
        <ProjectReference Include="$(XiHanLegacySrc)XiHan.Framework.Utils\XiHan.Framework.Utils.csproj" />
    </ItemGroup>

</Project>
