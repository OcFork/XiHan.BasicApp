<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\..\props\netcore.props" />
    <Import Project="..\..\..\props\common.props" />
    <Import Project="..\..\..\props\version.props" />
    <Import Project="..\..\..\props\nuget.props" />
    <Import Project="..\..\..\props\framework.props" />

    <PropertyGroup>
        <Title>XiHan.BasicApp.Core</Title>
        <AssemblyName>XiHan.BasicApp.Core</AssemblyName>
        <PackageId>XiHan.BasicApp.Core</PackageId>
        <Description>曦寒基础应用核心库</Description>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <!--
        曦寒框架引用：下面两组二选一，由 props\framework.props 的 UseXiHanFrameworkSource 决定
        （框架源码与本仓库并列检出时自动走源码，否则走 NuGet 包）。两组须保持同一份清单。
        全仓库的框架引用只集中在本工程与 XiHan.BasicApp.Web.Core，其余工程一律经这两者传递。
    -->
    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' != 'true' ">
        <PackageReference Include="XiHan.Framework.Kernel" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Auditing.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Security.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Caching.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Persistence.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Domain" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Messaging.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Localization.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Observability.OpenTelemetry" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Primitives" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.MultiTenancy.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.ObjectStorage.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Configuration.Abstractions" Version="5.0.0-preview.1" />
        <PackageReference Include="XiHan.Framework.Scheduling.Abstractions" Version="5.0.0-preview.1" />
    </ItemGroup>

    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' == 'true' ">
    </ItemGroup>

</Project>
