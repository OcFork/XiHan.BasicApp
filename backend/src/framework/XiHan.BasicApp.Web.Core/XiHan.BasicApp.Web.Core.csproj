<Project Sdk="Microsoft.NET.Sdk.Web">

    <Import Project="..\..\..\props\netcore.props" />
    <Import Project="..\..\..\props\common.props" />
    <Import Project="..\..\..\props\version.props" />
    <Import Project="..\..\..\props\nuget.props" />
    <Import Project="..\..\..\props\framework.props" />

    <PropertyGroup>
        <Title>XiHan.BasicApp.Web.Core</Title>
        <AssemblyName>XiHan.BasicApp.Web.Core</AssemblyName>
        <PackageId>XiHan.BasicApp.Web.Core</PackageId>
        <Description>曦寒基础应用 Web 核心库</Description>
        <OutputType>Library</OutputType>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    </PropertyGroup>

    <!-- 曦寒框架 Web 相关引用：两组二选一，规则同 XiHan.BasicApp.Core（见 props\framework.props） -->
    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' != 'true' ">
        <PackageReference Include="XiHan.Framework.Hosting.AspNetCore" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Protocols.Http" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Protocols.Grpc" Version="$(XiHanFrameworkVersion)" />
        <PackageReference Include="XiHan.Framework.Protocols.Mcp" Version="$(XiHanFrameworkVersion)" />
    </ItemGroup>

    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' == 'true' ">
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Hosting.AspNetCore\XiHan.Framework.Hosting.AspNetCore.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Protocols.Http\XiHan.Framework.Protocols.Http.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Protocols.Grpc\XiHan.Framework.Protocols.Grpc.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Protocols.Mcp\XiHan.Framework.Protocols.Mcp.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\XiHan.BasicApp.Core\XiHan.BasicApp.Core.csproj" />
    </ItemGroup>

</Project>
