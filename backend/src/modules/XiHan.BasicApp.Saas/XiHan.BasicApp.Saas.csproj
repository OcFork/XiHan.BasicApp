<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\..\props\netcore.props" />
    <Import Project="..\..\..\props\common.props" />
    <Import Project="..\..\..\props\version.props" />
    <Import Project="..\..\..\props\nuget.props" />
    <Import Project="..\..\..\props\framework.props" />

    <PropertyGroup>
        <Title>XiHan.BasicApp.Saas</Title>
        <AssemblyName>XiHan.BasicApp.Saas</AssemblyName>
        <PackageId>XiHan.BasicApp.Saas</PackageId>
        <Description>曦寒基础应用角色控制应用库</Description>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="HttpApi\**" />
      <EmbeddedResource Remove="HttpApi\**" />
      <None Remove="HttpApi\**" />
    </ItemGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- Redis 延迟队列、登录封禁等直接使用 Redis（与 5.0 Caching.Redis 同一连接） -->
    <ItemGroup>
      <PackageReference Include="StackExchange.Redis" Version="3.4.5" />
    </ItemGroup>

    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' != 'true' ">
      <PackageReference Include="XiHan.Framework.Caching.Redis" Version="$(XiHanFrameworkVersion)" />
    </ItemGroup>

    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' == 'true' ">
      <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Caching.Redis\XiHan.Framework.Caching.Redis.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\framework\XiHan.BasicApp.Web.Core\XiHan.BasicApp.Web.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="OpenApi\" />
    </ItemGroup>


</Project>
