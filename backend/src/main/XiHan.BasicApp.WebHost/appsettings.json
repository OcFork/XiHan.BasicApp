{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "XiHan": {
    // 5.0 操作端点统一挂在 /api 下：前端开发代理、OpenAPI 安全中间件的保护前缀与文件传输端点都按这个前缀
    "Protocols": {
      "Http": {
        "RoutePrefix": "/api"
      }
    }
  }
}