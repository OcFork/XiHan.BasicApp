<Project Sdk="Microsoft.NET.Sdk.Web">

    <Import Project="..\..\..\props\netcore.props" />
    <Import Project="..\..\..\props\common.props" />
    <Import Project="..\..\..\props\version.props" />
    <Import Project="..\..\..\props\framework.props" />

    <PropertyGroup>
        <Title>XiHan.BasicApp.WebHost</Title>
        <AssemblyName>XiHan.BasicApp.WebHost</AssemblyName>
        <PackageId>XiHan.BasicApp.WebHost</PackageId>
        <Description>曦寒基础应用 Web 主机</Description>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<OutputType>Exe</OutputType>
    </PropertyGroup>

    <!-- 组合根：Full 组合包提供各能力的默认实现与四种协议，SqlSugar Provider 顶替默认的内存持久化 -->
    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' != 'true' ">
      <PackageReference Include="XiHan.Framework.Profiles.Full" Version="$(XiHanFrameworkVersion)" />
    </ItemGroup>
    <ItemGroup Condition=" '$(UseXiHanFrameworkSource)' == 'true' ">
      <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Profiles.Full\XiHan.Framework.Profiles.Full.csproj" />
    </ItemGroup>
    <!-- P5-04 第一批：Saas、CodeGeneration、Printing、Chat；AI 与 Workflow 依赖 5.x 的 AI / Workflow 子系统，随 5.1 迁，暂不接入 -->
    <ItemGroup>
      <ProjectReference Include="..\..\modules\XiHan.BasicApp.Chat\XiHan.BasicApp.Chat.csproj" />
      <ProjectReference Include="..\..\modules\XiHan.BasicApp.CodeGeneration\XiHan.BasicApp.CodeGeneration.csproj" />
      <ProjectReference Include="..\..\modules\XiHan.BasicApp.Printing\XiHan.BasicApp.Printing.csproj" />
      <ProjectReference Include="..\..\modules\XiHan.BasicApp.Saas\XiHan.BasicApp.Saas.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="IpDatabases\ip2region_v4.xdb">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="IpDatabases\ip2region_v6.xdb">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ServiceScripts\XiHan.BasicApp.bat">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ServiceScripts\XiHan.BasicApp.ini">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Localization\**\*.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <!-- 数据库升级脚本：SqlScriptMigrationRunner 从 AppContext.BaseDirectory/UpdateScripts 读取，必须随输出/发布一同拷贝 -->
      <None Update="UpdateScripts\**\*.sql">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\" />
    </ItemGroup>

    <ItemGroup>
        <!-- xihan-migrate(V4-09): 用 MessageCatalog.FromEmbeddedResources("webhost", typeof(<本程序集里的类型>)) 加载嵌入目录并加进本地化特性；键为 webhost.<资源>.<键>。 -->
        <EmbeddedResource Include="Localization/*.json" LogicalName="Localization/%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
